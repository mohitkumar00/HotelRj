# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_.
# The anon/publishable key is designed to be public, but with the RLS migration
# applied it can only READ public tables (menu, rooms, tables). Writes need a paired device.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
